# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
# `.env` is gitignored - never commit real secrets.

# --- Azure AD / Entra app registration (D365 F&O tenant) ---
FNO_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FNO_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FNO_CLIENT_SECRET=your-client-secret-here

# --- F&O environment ---
# Sandbox/UAT: https://<name>-test.sandbox.operations.dynamics.com
# Production:  https://<name>.operations.dynamics.com
FNO_BASE_URL=https://your-org-test.sandbox.operations.dynamics.com
DATA_AREA_ID=KL

# --- Cryptware NRS e-invoicing API ---
CRYPTWARE_API_BASE_URL=https://preprod-api.cryptwaresystemsltd.com/
CRYPTWARE_API_KEY=sk_live_your_cryptware_api_key_here
